{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "mailly": {
      "type": "streamable-http",
      "url": "https://mcp.mailly.site/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://api.mailly.site/api/auth/oauth2/authorize",
            "tokenUrl": "https://api.mailly.site/api/auth/oauth2/token",
            "registrationUrl": "https://api.mailly.site/api/auth/oauth2/register",
            "authorizationServerBase": "https://api.mailly.site/api/auth",
            "resource": "https://mcp.mailly.site/mcp",
            "baseScopes": [
              "mail:read",
              "offline_access"
            ],
            "defaultScopes": [
              "mail:read",
              "mail:draft",
              "mail:send",
              "workspace:manage"
            ]
          }
        }
      }
    }
  }
}
