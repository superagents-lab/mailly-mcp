{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailly-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  // Hosted at https://mcp.mailly.site/mcp. Sign-in happens on Mailly's API (api.mailly.site/api/auth); this Worker
  // only passes the caller's credential through to the REST API.
  "routes": [{ "pattern": "mcp.mailly.site", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": false }],
  "build": { "command": "npm run build:ui" },
  "vars": {
    // MCP Apps UI (ui:// resources and tool UI metadata) stays off until the cards are ready.
    "MCP_APPS": "0",
    "MAILLY_API_URL": "https://api.mailly.site"
  },
  // Same-zone Workers cannot fetch each other's custom domains, so API calls go through this binding.
  "services": [
    { "binding": "MAILLY_API", "service": "mailly-server" }
  ],
  "observability": { "enabled": true }
}
