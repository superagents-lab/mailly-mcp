{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailly-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  // Not public: the hosted connector reaches this Worker only through the MCP_SERVICE binding on mailly-server,
  // which runs OAuth first. Self-hosters can add a route and call it with their own Mailly API key.
  "workers_dev": false,
  "preview_urls": false,
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": false }],
  "build": { "command": "npm run build:ui" },
  "vars": {
    // MCP Apps UI (ui:// resources and tool UI metadata) stays off until the cards are ready.
    "MCP_APPS": "0",
    "MAILLY_API_URL": "https://api.mailly.site"
  },
  "services": [
    { "binding": "MAILLY_API", "service": "mailly-server" }
  ],
  "observability": { "enabled": true }
}
