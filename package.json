{
  "name": "mailly-mcp",
  "version": "0.3.0",
  "private": true,
  "description": "Mailly's MCP server, Claude and Codex plugin, and the MCP Apps UI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build:ui": "node scripts/build-ui.mjs",
    "build": "node scripts/build-ui.mjs && node scripts/build-worker.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "npm run build:ui && wrangler dev",
    "deploy": "npm run build:ui && wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.23.0",
    "node-html-markdown": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260919.1",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@openai/mcp-extensions": "0.1.0",
    "dompurify": "3.4.15",
    "esbuild": "0.27.3",
    "miniflare": "^4.20260710.0",
    "typescript": "5.9.3",
    "wrangler": "4.111.0"
  }
}
